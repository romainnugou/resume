---
import '../styles/global.css';

export interface Props {
  name: string;
  title: string;
  lang: string;
  locales: string[];
  photo?: string | null;
  email?: string;
  phone?: string;
  url?: string;
  sameAs?: string[];
}

const { name, title, lang, locales, photo, email, phone, url, sameAs } = Astro.props;
const pageTitle = `${name} - ${title}`;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle: title,
  ...(photo && { image: photo }),
  ...(email && { email }),
  ...(phone && { telephone: phone }),
  ...(url && { url }),
  ...(sameAs && sameAs.length > 0 && { sameAs }),
};

const langCss = locales
  .map(
    (l) =>
      `html[data-active-lang="${l}"] [data-resume-lang="${l}"]{opacity:1;pointer-events:auto}`
  )
  .join('\n');
---

<html lang={lang} data-active-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={title} />
    <meta property="og:type" content="profile" />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
        window.addEventListener('beforeprint', () => document.documentElement.classList.remove('dark'));
        window.addEventListener('afterprint', () => {
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        });
      })();
    </script>
    {locales.length > 1 && (
      <>
        <style set:html={`[data-resume-lang]{grid-row:1;grid-column:1;opacity:0;pointer-events:none;transition:opacity .2s ease}\n${langCss}`} />
        <script is:inline define:vars={{ locales }}>
          (function () {
            function resolveLocale() {
              try {
                const stored = localStorage.getItem('lang');
                if (stored && locales.includes(stored)) return stored;
              } catch (e) {}
              const navLangs = navigator.languages || [navigator.language];
              for (const l of navLangs) {
                const short = l.slice(0, 2).toLowerCase();
                if (locales.includes(short)) return short;
              }
              return document.documentElement.getAttribute('data-active-lang');
            }

            function setActive(locale) {
              document.documentElement.setAttribute('data-active-lang', locale);
              document.documentElement.lang = locale;
              document.querySelectorAll('[data-lang-switch]').forEach((btn) => {
                btn.setAttribute('aria-current', btn.dataset.langSwitch === locale ? 'true' : 'false');
              });
              document.querySelectorAll('[data-resume-lang]').forEach((block) => {
                block.toggleAttribute('inert', block.dataset.resumeLang !== locale);
              });
            }

            const active = resolveLocale();
            document.documentElement.setAttribute('data-active-lang', active);
            document.documentElement.lang = active;
            document.addEventListener('DOMContentLoaded', () => setActive(active));

            document.addEventListener('click', (e) => {
              const btn = e.target.closest('[data-lang-switch]');
              if (!btn) return;
              const locale = btn.dataset.langSwitch;
              setActive(locale);
              try {
                localStorage.setItem('lang', locale);
              } catch (e) {}
            });
          })();
        </script>
      </>
    )}
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 print:bg-white print:text-black">
    <main class="max-w-3xl mx-auto px-4 pt-12 pb-12">
      <slot />
    </main>
  </body>
</html>
