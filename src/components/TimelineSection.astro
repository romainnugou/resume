---
import TimelineEntry from './TimelineEntry.astro';
import type { TimelineSectionData } from '../lib/parseResume';

export interface Props {
  section: TimelineSectionData;
  idPrefix?: string;
}

const { section, idPrefix } = Astro.props;
---

<section id={idPrefix ? `${idPrefix}-${section.slug}` : section.slug} class="mb-10 scroll-mt-24">
  <h2 class="text-xl font-semibold mb-4 border-b border-gray-200 dark:border-gray-800 pb-1">
    {section.heading}
  </h2>
  {section.introHtml && <div class="markdown-content mb-4" set:html={section.introHtml} />}
  <div class="space-y-8">
    {section.entries.map((entry, i) => (
      <TimelineEntry entry={entry} isLast={i === section.entries.length - 1} />
    ))}
  </div>
</section>
