---
export interface Props {
  defaultLocale: string;
  otherLocales: string[];
  currentLocale: string;
}

const { defaultLocale, otherLocales, currentLocale } = Astro.props;
const allLocales = [defaultLocale, ...otherLocales];
---

{
  allLocales.length > 1 && (
    <div class="flex gap-1 text-sm">
      {allLocales.map((locale) => (
        <button
          type="button"
          data-lang-switch={locale}
          class="lang-switch-btn px-2 py-1 hover:underline"
          aria-current={locale === currentLocale ? 'true' : 'false'}
        >
          {locale.toUpperCase()}
        </button>
      ))}
    </div>
  )
}

