---
export interface Props {
  defaultLocale: string;
  otherLocales: string[];
  currentLocale: string;
}

const { defaultLocale, otherLocales, currentLocale } = Astro.props;
const allLocales = [defaultLocale, ...otherLocales];
const languageName = new Intl.DisplayNames(['en'], { type: 'language' });
---

{
  allLocales.length > 1 &&
    allLocales.map((locale) => (
      <span class="group relative flex">
        <button
          type="button"
          data-lang-switch={locale}
          class="lang-switch-btn flex h-7 w-7 items-center justify-center rounded-full text-sm text-gray-900 hover:opacity-70 aria-[current=true]:bg-gray-100 dark:text-gray-100 dark:aria-[current=true]:bg-gray-800"
          aria-current={locale === currentLocale ? 'true' : 'false'}
        >
          {locale.toUpperCase()}
        </button>
        <span class="nav-tooltip" aria-hidden="true">{languageName.of(locale)}</span>
      </span>
    ))
}

