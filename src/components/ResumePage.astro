---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import Header from './Header.astro';
import ContactInfo from './ContactInfo.astro';
import Nav from './Nav.astro';
import Section from './Section.astro';
import TimelineSection from './TimelineSection.astro';
import type { ParsedResume } from '../lib/parseResume';

export interface Props {
  resumes: { locale: string; resume: ParsedResume; raw: string }[];
  defaultLocale: string;
}

const { resumes, defaultLocale } = Astro.props;
const otherLocales = resumes.map((r) => r.locale).filter((l) => l !== defaultLocale);
const isMultiLocale = resumes.length > 1;
const defaultResume = resumes.find((r) => r.locale === defaultLocale)!.resume;
const titles = Object.fromEntries(
  resumes.map(({ locale, resume }) => [locale, `${resume.name} - ${resume.title}`])
);
const defaultEmail = defaultResume.contact.find((f) => f.type === 'email')?.value;
const defaultPhone = defaultResume.contact.find((f) => f.type === 'phone')?.value;
---

<ResumeLayout
  name={defaultResume.name}
  title={defaultResume.title}
  lang={defaultLocale}
  locales={resumes.map((r) => r.locale)}
  titles={titles}
  photo={defaultResume.photo?.url}
  email={defaultEmail}
  phone={defaultPhone}
  sameAs={defaultResume.links.map((l) => l.url)}
>
  <div class="grid">
    {
      resumes.map(({ locale, resume, raw }) => (
        <div data-resume-lang={locale} class="[&>*:last-child]:mb-0">
          <Nav
            defaultLocale={defaultLocale}
            otherLocales={otherLocales}
            currentLocale={locale}
            markdown={raw}
          />
          <Header
            name={resume.name}
            title={resume.title}
            photo={resume.photo}
            skipTargetId={
              isMultiLocale ? `${locale}-main-content` : locale === defaultLocale ? 'main-content' : undefined
            }
          />
          <ContactInfo contact={resume.contact} links={resume.links} />
          {resume.summaryHtml && (
            <div class="markdown-content mb-8" set:html={resume.summaryHtml} />
          )}
          {resume.sections.map((section) =>
            section.type === 'timeline' ? (
              <TimelineSection section={section} idPrefix={locale} />
            ) : (
              <Section section={section} idPrefix={locale} />
            )
          )}
        </div>
      ))
    }
  </div>
  <footer class="mt-16 text-left text-sm text-gray-600 dark:text-gray-400 print:hidden">
    Built with <a href="https://github.com/romainnugou/resume" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70">Resume<span class="sr-only"> (opens in new tab)</span></a> by <a href="https://romain.ng/" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70">Romain Nugou<span class="sr-only"> (opens in new tab)</span></a>
  </footer>
</ResumeLayout>
