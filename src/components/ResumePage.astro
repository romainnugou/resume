---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import Header from './Header.astro';
import ContactInfo from './ContactInfo.astro';
import Nav from './Nav.astro';
import Section from './Section.astro';
import TimelineSection from './TimelineSection.astro';
import type { ParsedResume } from '../lib/parseResume';

export interface Props {
  resumes: { locale: string; resume: ParsedResume }[];
  defaultLocale: string;
}

const { resumes, defaultLocale } = Astro.props;
const otherLocales = resumes.map((r) => r.locale).filter((l) => l !== defaultLocale);
const defaultResume = resumes.find((r) => r.locale === defaultLocale)!.resume;
---

<ResumeLayout
  name={defaultResume.name}
  title={defaultResume.title}
  lang={defaultLocale}
  locales={resumes.map((r) => r.locale)}
>
  <div class="grid">
    {
      resumes.map(({ locale, resume }) => (
        <div data-resume-lang={locale}>
          <Nav defaultLocale={defaultLocale} otherLocales={otherLocales} currentLocale={locale} />
          <Header name={resume.name} title={resume.title} photo={resume.photo} />
          <ContactInfo
            email={resume.email}
            phone={resume.phone}
            address={resume.address}
            links={resume.links}
          />
          {resume.summaryHtml && (
            <div class="markdown-content mt-6 mb-10" set:html={resume.summaryHtml} />
          )}
          {resume.sections.map((section) =>
            section.type === 'timeline' ? (
              <TimelineSection section={section} idPrefix={locale} />
            ) : (
              <Section section={section} idPrefix={locale} />
            )
          )}
        </div>
      ))
    }
  </div>
</ResumeLayout>
