---
import type { Link, Photo } from '../lib/parseResume';

export interface Props {
  name: string;
  title: string;
  photo: Photo | null;
  email?: string;
  phone?: string;
  address?: string;
  links: Link[];
  summaryHtml: string;
}

const { name, title, photo, email, phone, address, links, summaryHtml } = Astro.props;
const hasContactInfo = email || phone || address || links.length > 0;
---

<header class="mb-10 flex flex-col sm:flex-row gap-6 sm:items-center">
  {
    photo && (
      <img
        src={photo.url}
        alt={photo.alt}
        class="w-24 h-24 rounded-full object-cover shrink-0"
      />
    )
  }
  <div>
    <h1 class="text-3xl font-bold tracking-tight">{name}</h1>
    <p class="text-lg text-gray-600 dark:text-gray-400">{title}</p>
    {
      hasContactInfo && (
        <ul class="mt-2 space-y-1 text-sm">
          {email && (
            <li>
              Email:{' '}
              <a href={`mailto:${email}`} class="underline hover:no-underline">
                {email}
              </a>
            </li>
          )}
          {phone && (
            <li>
              Phone:{' '}
              <a href={`tel:${phone}`} class="underline hover:no-underline">
                {phone}
              </a>
            </li>
          )}
          {address && <li>Address: {address}</li>}
          {links.map((link) => (
            <li>
              {link.label}:{' '}
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:no-underline"
              >
                {link.url}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {summaryHtml && <div class="markdown-content mt-4" set:html={summaryHtml} />}
  </div>
</header>
