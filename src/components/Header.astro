---
import type { Photo } from '../lib/parseResume';

export interface Props {
  name: string;
  title: string;
  photo: Photo | null;
  skipTargetId?: string;
}

const { name, title, photo, skipTargetId } = Astro.props;
---

<header id={skipTargetId} tabindex={skipTargetId ? -1 : undefined} class="mb-8 flex flex-col sm:flex-row gap-6 sm:items-center focus:outline-none">
  {
    photo && (
      <img
        src={photo.url}
        alt={photo.alt}
        class="w-20 h-20 rounded-full object-cover shrink-0"
      />
    )
  }
  <div>
    <h1 class="text-3xl font-bold tracking-tight">{name}</h1>
    <p class="text-lg text-gray-600 dark:text-gray-400">{title}</p>
  </div>
</header>
