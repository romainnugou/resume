---
import type { ProseSection } from '../lib/parseResume';

export interface Props {
  section: ProseSection;
  idPrefix?: string;
}

const { section, idPrefix } = Astro.props;
---

<section id={idPrefix ? `${idPrefix}-${section.slug}` : section.slug} class="mb-8 scroll-mt-24">
  <h2 class="text-xl font-semibold mb-4 border-b border-gray-200 dark:border-gray-800 pb-1">
    {section.heading}
  </h2>
  <div class="markdown-content" set:html={section.html} />
</section>
