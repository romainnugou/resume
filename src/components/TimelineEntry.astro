---
import type { TimelineEntry } from '../lib/parseResume';

export interface Props {
  entry: TimelineEntry;
  isLast?: boolean;
}

const { entry, isLast = false } = Astro.props;
---

<div class="relative pl-6">
  <span
    class="absolute left-0 top-1.5 -translate-x-1/2 w-3 h-3 rounded-full bg-gray-400 dark:bg-gray-600 border-2 border-white dark:border-gray-900 print:[print-color-adjust:exact] print:[-webkit-print-color-adjust:exact]"
  />
  {
    !isLast && (
      <span class="absolute left-0 -translate-x-1/2 top-1.5 bottom-[-2rem] border-l-2 border-gray-300 dark:border-gray-700" />
    )
  }
  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
    <h3 class="font-medium">
      {entry.title}
      {
        entry.org && (
          <span class="text-gray-600 dark:text-gray-400">
            {' '}
            ·{' '}
            {entry.orgUrl ? (
              <a
                href={entry.orgUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:no-underline"
              >
                {entry.org}
              </a>
            ) : (
              entry.org
            )}
          </span>
        )
      }
    </h3>
    {entry.dates && <span class="text-sm text-gray-500 whitespace-nowrap">{entry.dates}</span>}
  </div>
  {entry.html && <div class="markdown-content text-sm mt-1" set:html={entry.html} />}
</div>
