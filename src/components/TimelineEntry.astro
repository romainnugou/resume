---
import type { TimelineEntry } from '../lib/parseResume';

export interface Props {
  entry: TimelineEntry;
  isLast?: boolean;
}

const { entry, isLast = false } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-[8rem_1fr] md:grid-cols-[8rem_20px_1fr] gap-x-4">
  <span>
    {entry.dates}
  </span>
  <div class="relative hidden md:flex justify-center translate-x-1.5">
    <span
      class="mt-1.5 h-3 w-3 rounded-full bg-gray-400 dark:bg-gray-600 border-2 border-white dark:border-gray-900 print:[print-color-adjust:exact] print:[-webkit-print-color-adjust:exact]"
    />
    {
      !isLast && (
        <span class="absolute left-1/2 top-[26px] bottom-[-30px] w-0.5 -translate-x-1/2 bg-gray-300 dark:bg-gray-700 print:[print-color-adjust:exact] print:[-webkit-print-color-adjust:exact]" />
      )
    }
  </div>
  <div>
    <h3 class="font-medium">
      {entry.title}
      {
        entry.org && (
          <span class="block sm:inline">
            <span class="hidden sm:inline">{' '}-{' '}</span>
            {entry.orgUrl ? (
              <a
                href={entry.orgUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:opacity-70"
              >
                {entry.org}
                <span class="sr-only"> (opens in new tab)</span>
              </a>
            ) : (
              entry.org
            )}
          </span>
        )
      }
      {
        entry.location && (
          <span class="block sm:inline">
            <span class="hidden sm:inline">{' '}-{' '}</span>
            {entry.location}
          </span>
        )
      }
    </h3>
    {entry.html && <div class="markdown-content text-sm leading-loose mt-4" set:html={entry.html} />}
  </div>
</div>
