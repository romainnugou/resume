---
import type { TimelineEntry } from '../lib/parseResume';

export interface Props {
  entry: TimelineEntry;
  isLast?: boolean;
}

const { entry, isLast = false } = Astro.props;
---

<div class="grid grid-cols-[20px_1fr] gap-x-4">
  <div class="relative flex justify-center">
    <span
      class="mt-1.5 h-3 w-3 rounded-full bg-gray-400 dark:bg-gray-600 border-2 border-white dark:border-gray-900 print:[print-color-adjust:exact] print:[-webkit-print-color-adjust:exact]"
    />
    {
      !isLast && (
        <span class="absolute left-1/2 top-[26px] bottom-[-30px] w-0.5 -translate-x-1/2 bg-gray-300 dark:bg-gray-700" />
      )
    }
  </div>
  <div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
      <h3 class="font-medium">
        {entry.title}
        {
          entry.org && (
            <span class="text-gray-600 dark:text-gray-400">
              {' '}
              ·{' '}
              {entry.orgUrl ? (
                <a
                  href={entry.orgUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline hover:no-underline"
                >
                  {entry.org}
                </a>
              ) : (
                entry.org
              )}
            </span>
          )
        }
      </h3>
      {entry.dates && (
        <span class="text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap">
          {entry.dates}
        </span>
      )}
    </div>
    {entry.html && <div class="markdown-content text-sm mt-4" set:html={entry.html} />}
  </div>
</div>
